{
  "name": "greece-battleground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "assets:verify": "node scripts/check-public-assets.mjs",
    "verify": "pnpm test && pnpm assets:verify && pnpm exec tsc --noEmit -p server && pnpm build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  }
}
